# HTTP API
NODE_ENV=development
API_PORT=3000

# Web application (public, non-secret browser configuration)
VITE_API_BASE_URL=http://localhost:3000/api/v1
MINIO_CORS_ALLOWED_ORIGIN=http://localhost:5173

# Local infrastructure (safe development defaults only)
POSTGRES_DB=doclens
POSTGRES_USER=doclens
POSTGRES_PASSWORD=doclens_local_password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://doclens:doclens_local_password@localhost:5433/doclens?schema=public

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Standalone worker
WORKER_STARTUP_TIMEOUT_MS=5000

MINIO_ROOT_USER=doclensminio
MINIO_ROOT_PASSWORD=doclensminio_local_password
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# S3-compatible object storage (backend-only credentials)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=doclens-documents
S3_ACCESS_KEY_ID=doclensminio
S3_SECRET_ACCESS_KEY=doclensminio_local_password
S3_FORCE_PATH_STYLE=true
S3_PRESIGNED_UPLOAD_EXPIRATION_SECONDS=600

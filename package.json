{
  "name": "@doclens/root",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.6.3",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "prisma"
    ]
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @doclens/api --filter @doclens/worker --filter @doclens/web --if-present run dev",
    "dev:api": "pnpm --filter @doclens/api --if-present run dev",
    "dev:worker": "pnpm --filter @doclens/worker --if-present run dev",
    "dev:web": "pnpm --filter @doclens/web --if-present run dev",
    "db:migrate": "pnpm --filter @doclens/database run prisma:deploy",
    "lint": "pnpm --recursive --if-present run lint",
    "typecheck": "pnpm --recursive --if-present run typecheck",
    "test": "pnpm --recursive --if-present run test",
    "build": "pnpm --recursive --if-present run build"
  },
  "devDependencies": {
    "typescript": "5.7.3"
  }
}

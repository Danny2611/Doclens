{
  "name": "@doclens/worker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node --watch --require ./scripts/register-ts-node.cjs src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc --project tsconfig.app.json",
    "test": "jest --runInBand",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@doclens/database": "workspace:*",
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.11",
    "ioredis": "5.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@nestjs/testing": "11.0.11",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "eslint": "9.21.0",
    "jest": "29.7.0",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.25.0"
  }
}

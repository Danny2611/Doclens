{
  "name": "@doclens/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "prepare:shared": "pnpm --filter @doclens/database... --filter @doclens/contracts... --filter @doclens/storage... run build",
    "predev": "pnpm run prepare:shared",
    "dev": "node --env-file-if-exists=../../.env --watch --require ./scripts/register-ts-node.cjs src/main.ts",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "pretypecheck": "pnpm run prepare:shared",
    "typecheck": "tsc --project tsconfig.app.json",
    "pretest": "pnpm run prepare:shared",
    "test": "jest --runInBand",
    "prebuild": "pnpm run prepare:shared",
    "build": "tsc --project tsconfig.build.json"
  },
  "dependencies": {
    "@nestjs/common": "11.0.11",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.0.11",
    "@nestjs/platform-express": "11.0.11",
    "@doclens/contracts": "workspace:*",
    "@doclens/database": "workspace:*",
    "@doclens/domain": "workspace:*",
    "@doclens/storage": "workspace:*",
    "@doclens/queue": "workspace:*",
    "bullmq": "5.58.5",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "9.21.0",
    "@nestjs/testing": "11.0.11",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.10",
    "@types/supertest": "6.0.2",
    "eslint": "9.21.0",
    "jest": "29.7.0",
    "supertest": "7.0.0",
    "ts-jest": "29.2.6",
    "ts-node": "10.9.2",
    "typescript-eslint": "8.25.0"
  }
}

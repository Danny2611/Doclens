{
  "name": "@doclens/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"test/**/*.{ts,tsx}\"",
    "typecheck": "tsc --project tsconfig.app.json",
